{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./bin",
    "rootDir": "./bin",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["bin/**/*.ts"],
  "exclude": ["node_modules"]
}
